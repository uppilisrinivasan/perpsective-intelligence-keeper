# =============================================================================
# Keeper · environment configuration
# Copy to .env (./run.sh does this). Never commit .env. Keep secrets only here.
# =============================================================================

# ---- Model provider ---------------------------------------------------------
# nebius            : NVIDIA Nemotron on Nebius Token Factory (required for the competition)
# openai_compatible : any OpenAI-compatible endpoint (e.g. self-hosted Nemotron via vLLM on Nebius)
# fake              : offline fixtures for tests (no network, no cost)
LLM_PROVIDER=nebius

# Required for live mode. Create at https://tokenfactory.nebius.com (API keys).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Only for LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=

# ---- Models per role (IDs change; see config/models.yaml and ./run.sh --check) ----
KEEPER_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
KEEPER_MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b
KEEPER_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
# Empty = same as JUDGE
KEEPER_MODEL_ASSISTANT=

# ---- Gateway limits ----------------------------------------------------------
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=2
LLM_MAX_CONCURRENCY=8
LLM_RATE_LIMIT_RPM=120
# 0 = no daily token ceiling
LLM_TOKENS_PER_DAY=0
# true = cache identical requests in .runtime/cache (saves money on reruns)
LLM_CACHE=true
# Dev only: write prompts and responses to .runtime/logs/llm/ (git-ignored)
LLM_LOG_PROMPTS=false

# ---- Spending -----------------------------------------------------------------
KEEPER_SPEND_CAP_USD=20
# day | month | total
KEEPER_SPEND_CAP_PERIOD=month
# Actions estimated below this run without asking
KEEPER_AUTO_APPROVE_USD=0.05

# ---- Batch API and embeddings ---------------------------------------------------
BATCH_API_ENABLED=false
# none (TF-IDF/BM25 only) | nebius (an embeddings model listed in config/models.yaml)
EMBEDDINGS_PROVIDER=none

# ---- GitHub (import of real public repositories only; read-only) ----------------
# A fine-grained token with NO permissions beyond public read is enough. Optional.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
IMPORT_ALLOWED=true

# ---- Sandbox for tests and fixes -------------------------------------------------
# contree (Token Factory Sandboxes, needs access) | docker | local
SANDBOX_PROVIDER=local
# Only for SANDBOX_PROVIDER=contree [verify names in the Token Factory Sandboxes docs]
CONTREE_API_URL=
CONTREE_API_KEY=
KEEPER_KEEP_SANDBOXES=false

# ---- External services ------------------------------------------------------------
# Optional: web search for hand-off notes
TAVILY_API_KEY=
OSV_API_URL=https://api.osv.dev/v1

# ---- App ---------------------------------------------------------------------------
# demo | workspace
KEEPER_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8430
FRONTEND_DEV_PORT=5174
OPEN_BROWSER=true
KEEPER_DATA_DIR=./data
KEEPER_RUNTIME_DIR=./.runtime
KEEPER_CONFIG_DIR=./config
# Empty = sqlite:///${KEEPER_RUNTIME_DIR}/keeper.db
DATABASE_URL=
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
JOB_WORKERS=2
API_DOCS=true

# ---- Cloud access (leave as is locally) ----------------------------------------------
# none | access_code
KEEPER_AUTH_MODE=none
# Comma-separated codes for judges (cloud only; store in SecretStash)
KEEPER_ACCESS_CODES=
# Long random string (cloud only): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KEEPER_SESSION_SECRET=
API_RATE_LIMIT_PER_MINUTE=120

# ---- Jobs -----------------------------------------------------------------------------
# local | nebius (heavy jobs on Nebius Serverless Jobs; see docs/09-deployment)
JOB_RUNNER=local

# ---- Data generation (build team only; see docs/03-data/06-synthetic-data-generation.md) ----
DATAGEN_PROFILE=demo
DATAGEN_SEED=20261025
DATAGEN_SPEND_CAP_USD=25
DATAGEN_CONCURRENCY=6

# ---- Nebius deployment (scripts in infra/nebius; not used by ./run.sh) ------------------
NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1
NEBIUS_REGISTRY=
NEBIUS_SUBNET_ID=
S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
S3_REGION=eu-north1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloud only (JOB_RUNNER=nebius): service-account credentials JSON content, from SecretStash
NEBIUS_SA_CREDENTIALS=
# text | json (json is used automatically when stdout is not a terminal)
LOG_FORMAT=
