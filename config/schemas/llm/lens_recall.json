{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lens_recall",
  "type": "object",
  "properties": {
    "relevant_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "why"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "relevant_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "why"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    }
  },
  "required": [
    "relevant_items",
    "relevant_findings"
  ],
  "additionalProperties": false
}
