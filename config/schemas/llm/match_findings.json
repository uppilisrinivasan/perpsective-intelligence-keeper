{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "match_findings",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pair_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "match",
              "partial",
              "none"
            ]
          },
          "same_concern": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "pair_id",
          "decision",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false
}
