{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "practice_score",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pair_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "match",
              "partial",
              "none"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "pair_id",
          "decision"
        ],
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "matches",
              "valid_other",
              "not_an_issue",
              "unclear"
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "note_id",
          "verdict"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions",
    "feedback"
  ],
  "additionalProperties": false
}
