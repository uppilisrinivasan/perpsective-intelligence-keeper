    "author_association": "OWNER",
    "body": "Please raise `IncludeError` (a LaminaError subclass) here, with the line and column; callers catch LaminaError.",
    "commit_id": "d734e0b4865388b0c3e47d748856917b7d99986e",
    "created_at": "2023-12-19T12:22:22Z",
