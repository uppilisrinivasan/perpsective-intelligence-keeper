    "author_association": "OWNER",
    "body": "Please don't put the environment value of `name` in the error message; it ends up in CI logs. The variable name is enough.",
    "commit_id": "097f176a4767c23beb9eed9ec26918d18d97934c",
    "created_at": "2024-04-19T07:00:04Z",
    "diff_hunk": "@@ -11,25 +11,24 @@ def _valid(value: str) -> bool:\n \n \n def interpolate_typed_bool(value: str, env: Mapping[str, str], *, line: int = 0, skip: list[str] | None = None) -> str:\n-    \"\"\"Expand ${NAME} references in value using env (typed bool rules).\"\"\"\n     skip = list(skip or [])\n     skip.append(value)\n-    outParts: list[str] = []\n+    pieces: list[str] = []\n     i = 0\n     while True:\n         start = value.find(\"${\", i)\n         if start < 0:\n-            outParts.append(value[i:])\n-            return \"\".join(outParts)\n+            pieces.append(value[i:])\n+            return \"\".join(pieces)\n         end = value.find(\"}\", start)\n         if end < 0:\n             raise ValueError(\"unterminated reference\")\n-        outParts.append(value[i:start])\n+        pieces.append(value[i:start])\n         name = value[start + 2:end]\n         if name not in env:\n             raise InterpolationError(f\"undefined variable {name}\", line, start + 1)\n         resolved = env[name]\n         if not _valid(resolved):\n             raise InterpolationError(f\"invalid value {resolved!r} for {name}\", line, start + 1)",
