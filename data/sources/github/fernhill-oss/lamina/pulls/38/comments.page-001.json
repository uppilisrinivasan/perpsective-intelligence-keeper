    "author_association": "OWNER",
    "body": "This calls `re` for every character in the tokenizer loop. The tokenizer is the hot path: `ch.isspace()` does the same without a regex per character.",
    "commit_id": "7aa0a052b0666e4d446ce64b50e8a10e903ab92c",
    "created_at": "2024-04-24T08:22:12Z",
    "diff_hunk": "@@ -0,0 +1,25 @@\n+\"\"\"Escape tokens inside a value (the tokenizer is the hot path).\"\"\"\n+\n+import re\n+\n+from lamina.lexer.core import Token\n+\n+\n+def scan_escape(value: str, line: int, *, skip: list[str] | None = None) -> list[Token]:\n+    skip = list(skip or [])\n+    skip.append(value)\n+    tokens: list[Token] = []\n+    current_word: list[str] = []\n+    start = 1\n+    for column, ch in enumerate(value, start=1):\n+        if re.match(r\"[\\s:]\", ch):",
