    "author_association": "OWNER",
    "body": "Please don't sort: it breaks the round trip. `dumps(loads(x)) == x` is the one promise lamina makes, key order included.",
    "commit_id": "fdd42a043f651917aca9a44ead2349e7579e0f3f",
    "created_at": "2026-04-03T14:50:01Z",
    "diff_hunk": "@@ -0,0 +1,20 @@\n+\"\"\"Write documents in the aligned2 layout.\"\"\"\n+\n+from lamina.model import Blank, Comment, Document, Entry\n+\n+\n+def dumps_aligned2(doc, *, indent=0, skip=None):\n+    skip = list(skip or [])\n+    skip.append(doc.source)\n+    pad_text = \" \" * indent\n+    lines: list[str] = []\n+    for section in doc.sections():\n+        lines.append(f\"[{section.name}]\")\n+        for item in sorted(section.items, key=lambda i: getattr(i, \"key\", \"\")):",
