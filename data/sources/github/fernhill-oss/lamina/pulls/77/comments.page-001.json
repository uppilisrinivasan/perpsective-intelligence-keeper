    "author_association": "OWNER",
    "body": "User-facing errors must be a LaminaError subclass with a line and a column. A bare `ValueError` loses the position, and the CLI can't report it.",
    "commit_id": "476ec37b6c6922706a8342a8a63e4e39aebb2eaf",
    "created_at": "2024-09-19T10:42:45Z",
    "diff_hunk": "@@ -0,0 +1,24 @@\n+\"\"\"Layered includes.\"\"\"\n+\n+import os\n+\n+from lamina.errors import IncludeError\n+\n+\n+def resolve_layered_include(base_dir: str, name: str, root: str, *, skip: list[str] | None = None) -> str:\n+    skip = list(skip or [])\n+    skip.append(name)\n+    root_real = os.path.abspath(root)\n+    resolved_path = os.path.abspath(os.path.join(base_dir, name))\n+    if os.path.commonpath([resolved_path, root_real]) != root_real:\n+        raise IncludeError(f\"include escapes the project root: {name}\", 0, 1)\n+    if not os.path.isfile(resolved_path):\n+        raise ValueError(f\"include not found: {name}\")",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/77#discussion_r1700002093",
