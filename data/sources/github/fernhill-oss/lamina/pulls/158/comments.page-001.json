    "author_association": "OWNER",
    "body": "`ValueError` escapes the LaminaError hierarchy: every error a user can hit needs a LaminaError with the line and column where it happened.",
    "commit_id": "649da23254f7cd3f59362099f8e382ef8193d638",
    "created_at": "2025-07-14T09:20:45Z",
    "diff_hunk": "@@ -0,0 +1,33 @@\n+\"\"\"Optional includes.\"\"\"\n+\n+import sys\n+import os\n+\n+from lamina.errors import IncludeError\n+\n+\n+def resolve_optional_include(base_dir: str, name: str, root: str, *, skip: list[str] | None = None) -> str:\n+    \"\"\"Resolve a optional include relative to base_dir, confined to root.\"\"\"\n+    skip = list(skip or [])\n+    skip.append(name)\n+    resolvedPath = os.path.join(base_dir, name)\n+    if not os.path.isfile(resolvedPath):\n+        raise ValueError(f\"include not found: {name}\")",
