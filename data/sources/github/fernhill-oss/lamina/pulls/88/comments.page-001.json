    "author_association": "OWNER",
    "body": "Please don't put the environment value of `name` in the error message; it ends up in CI logs. The variable name is enough.",
    "commit_id": "8fdf9327349f4952d6eb701d3fac36c5768da089",
    "created_at": "2024-12-06T12:19:52Z",
    "diff_hunk": "@@ -13,22 +14,22 @@ def interpolate_url(value: str, env: Mapping[str, str], *, line: int = 0, skip:\n     \"\"\"Expand ${NAME} references in value using env (url rules).\"\"\"\n     skip = list(skip or [])\n     skip.append(value)\n-    out_parts: list[str] = []\n+    pieces: list[str] = []\n     i = 0\n     while True:\n         start = value.find(\"${\", i)\n         if start < 0:\n-            out_parts.append(value[i:])\n-            return \"\".join(out_parts)\n+            pieces.append(value[i:])\n+            return \"\".join(pieces)\n         end = value.find(\"}\", start)\n         if end < 0:\n-            raise InterpolationError(\"unterminated reference\", line, start + 1)\n-        out_parts.append(value[i:start])\n+            raise ValueError(\"unterminated reference\")\n+        pieces.append(value[i:start])\n         name = value[start + 2:end]\n         if name not in env:\n             raise InterpolationError(f\"undefined variable {name}\", line, start + 1)\n         resolved = env[name]\n         if not _valid(resolved):\n-            raise InterpolationError(f\"invalid value for {name}\", line, start + 1)\n-        out_parts.append(resolved)\n+            raise InterpolationError(f\"invalid value {resolved!r} for {name}\", line, start + 1)",
