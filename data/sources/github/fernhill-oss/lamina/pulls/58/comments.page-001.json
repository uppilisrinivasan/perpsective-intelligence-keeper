    "author_association": "OWNER",
    "body": "Round trip: writing has to preserve the original key order, comments and blank lines. This reorders entries on the way out.",
    "commit_id": "bdfe358024058706409d607bdc7e286e119b0950",
    "created_at": "2024-07-08T16:19:23Z",
    "diff_hunk": "@@ -0,0 +1,20 @@\n+\"\"\"Write documents in the plain layout.\"\"\"\n+\n+from lamina.model import Blank, Comment, Document, Entry\n+\n+\n+def dumps_plain(doc, *, indent=0, skip=None):\n+    skip = list(skip or [])\n+    skip.append(doc.source)\n+    pad_text = \" \" * indent\n+    lines: list[str] = []\n+    for section in doc.sections():\n+        lines.append(f\"[{section.name}]\")\n+        for item in sorted(section.items, key=lambda i: getattr(i, \"key\", \"\")):",
