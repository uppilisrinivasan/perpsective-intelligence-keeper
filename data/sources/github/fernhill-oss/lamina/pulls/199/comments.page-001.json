    "author_association": "OWNER",
    "body": "This include path can still escape the project root through a symlink: abspath isn't enough. Resolve with realpath before the root check.",
    "commit_id": "d96f3978d7be88d73452138a6ab02cdbec5dc5b2",
    "created_at": "2025-11-03T11:41:52Z",
    "diff_hunk": "@@ -0,0 +1,24 @@\n+\"\"\"Nested includes.\"\"\"\n+\n+import os\n+\n+from lamina.errors import IncludeError\n+\n+\n+def resolve_nested_include(base_dir: str, name: str, root: str, *, skip: list[str] = []) -> str:\n+    \"\"\"Resolve a nested include relative to base_dir, confined to root.\"\"\"\n+    skip.append(name)\n+    root_real = os.path.abspath(root)\n+    resolved_path = os.path.abspath(os.path.join(base_dir, name))",
