    "author_association": "OWNER",
    "body": "User-facing errors must be a LaminaError subclass with a line and a column. A bare `ValueError` loses the position, and the CLI can't report it.",
    "commit_id": "d96f3978d7be88d73452138a6ab02cdbec5dc5b2",
    "created_at": "2025-11-03T11:41:52Z",
    "diff_hunk": "@@ -0,0 +1,24 @@\n+\"\"\"Nested includes.\"\"\"\n+\n+import os\n+\n+from lamina.errors import IncludeError\n+\n+\n+def resolve_nested_include(base_dir: str, name: str, root: str, *, skip: list[str] = []) -> str:\n+    \"\"\"Resolve a nested include relative to base_dir, confined to root.\"\"\"\n+    skip.append(name)\n+    root_real = os.path.abspath(root)\n+    resolved_path = os.path.abspath(os.path.join(base_dir, name))\n+    if os.path.commonpath([resolved_path, root_real]) != root_real:\n+        raise IncludeError(f\"include escapes the project root: {name}\", 0, 1)\n+    if not os.path.isfile(resolved_path):\n+        raise ValueError(f\"include not found: {name}\")",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/199#discussion_r1700004806",
    "id": 1700004806,
    "line": null,
