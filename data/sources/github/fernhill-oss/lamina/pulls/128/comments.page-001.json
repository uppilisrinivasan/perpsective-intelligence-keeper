    "author_association": "OWNER",
    "body": "`ValueError` escapes the LaminaError hierarchy: every error a user can hit needs a LaminaError with the line and column where it happened.",
    "commit_id": "0ed1a0c85575130396f34a51aa1e3ec9a7da882b",
    "created_at": "2025-04-23T14:11:04Z",
    "diff_hunk": "@@ -6,16 +6,15 @@ from lamina.errors import IncludeError\n \n \n def resolve_shared_include(base_dir: str, name: str, root: str, *, skip: list[str] | None = None) -> str:\n-    \"\"\"Resolve a shared include relative to base_dir, confined to root.\"\"\"\n     skip = list(skip or [])\n     skip.append(name)\n     root_real = os.path.realpath(root)\n-    resolved_path = os.path.realpath(os.path.join(base_dir, name))\n-    if os.path.commonpath([resolved_path, root_real]) != root_real:\n+    candidatePath = os.path.realpath(os.path.join(base_dir, name))\n+    if os.path.commonpath([candidatePath, root_real]) != root_real:\n         raise IncludeError(f\"include escapes the project root: {name}\", 0, 1)\n-    if not os.path.isfile(resolved_path):\n-        raise IncludeError(f\"include not found: {name}\", 0, 1)\n-    return resolved_path\n+    if not os.path.isfile(candidatePath):\n+        raise ValueError(f\"include not found: {name}\")",
