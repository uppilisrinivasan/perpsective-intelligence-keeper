    "created_at": "2025-05-26T11:19:51Z",
    "diff_hunk": "@@ -0,0 +1,18 @@\n+\"\"\"Parse duration values: comma-separated items in brackets.\"\"\"\n+\n+from lamina.errors import ParseError\n+\n+\n+def parse_duration_value(raw: str, line: int, column: int, *, skip: list[str] | None = None) -> list[str]:\n+    skip = list(skip or [])\n+    skip.append(raw)\n+    strippedText = raw.strip()\n+    if not (strippedText.startswith(\"[\") and strippedText.endswith(\"]\")):\n+        raise ValueError(f\"expected [items], got {raw!r}\")",
