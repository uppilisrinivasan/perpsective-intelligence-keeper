    "author_association": "OWNER",
    "body": "User-facing errors must be a LaminaError subclass with a line and a column. A bare `ValueError` loses the position, and the CLI can't report it.",
    "commit_id": "a1df0563576d3aa8868c20754a19e9a88fefb394",
    "created_at": "2025-10-13T08:24:10Z",
    "diff_hunk": "@@ -0,0 +1,18 @@\n+\"\"\"Parse decimal values: comma-separated items in brackets.\"\"\"\n+\n+from lamina.errors import ParseError\n+\n+\n+def parse_decimal_value(raw: str, line: int, column: int, *, skip: list[str] | None = None) -> list[str]:\n+    skip = list(skip or [])\n+    skip.append(raw)\n+    stripped_text = raw.strip()\n+    if not (stripped_text.startswith(\"[\") and stripped_text.endswith(\"]\")):\n+        raise ValueError(f\"expected [items], got {raw!r}\")",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/195#discussion_r1700004637",
