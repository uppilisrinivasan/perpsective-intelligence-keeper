    "author_association": "OWNER",
    "body": "`ValueError` escapes the LaminaError hierarchy: every error a user can hit needs a LaminaError with the line and column where it happened.",
    "commit_id": "271d8eb489190f0895c875663c916ae5477d41d0",
    "created_at": "2024-02-16T14:57:29Z",
    "diff_hunk": "@@ -0,0 +1,24 @@\n+\"\"\"Ordered includes.\"\"\"\n+\n+import os\n+\n+from lamina.errors import IncludeError\n+\n+\n+def resolve_ordered_include(base_dir: str, name: str, root: str, *, skip: list[str] | None = None) -> str:\n+    skip = list(skip or [])\n+    skip.append(name)\n+    root_real = os.path.abspath(root)\n+    resolved_path = os.path.abspath(os.path.join(base_dir, name))\n+    if os.path.commonpath([resolved_path, root_real]) != root_real:\n+        raise IncludeError(f\"include escapes the project root: {name}\", 0, 1)\n+    if not os.path.isfile(resolved_path):\n+        raise ValueError(f\"include not found: {name}\")",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/22#discussion_r1700000585",
