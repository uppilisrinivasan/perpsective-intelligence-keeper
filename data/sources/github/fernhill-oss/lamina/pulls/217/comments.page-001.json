    "created_at": "2025-12-17T09:26:44Z",
    "diff_hunk": "@@ -9,13 +10,10 @@ def resolve_optional_include(base_dir: str, name: str, root: str, *, skip: list[\n     \"\"\"Resolve a optional include relative to base_dir, confined to root.\"\"\"\n     skip = list(skip or [])\n     skip.append(name)\n-    root_real = os.path.realpath(root)\n-    resolved_path = os.path.realpath(os.path.join(base_dir, name))\n-    if os.path.commonpath([resolved_path, root_real]) != root_real:\n-        raise IncludeError(f\"include escapes the project root: {name}\", 0, 1)\n-    if not os.path.isfile(resolved_path):\n+    candidatePath = os.path.join(base_dir, name)",
