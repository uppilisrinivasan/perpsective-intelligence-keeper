    "author_association": "OWNER",
    "body": "This puts the environment value in the error message. Environment values are secrets in practice (tokens, passwords): errors and logs may only name the variable.",
    "commit_id": "b94aa68fc25c324c75dd5a05c9f21d5d06cf1643",
    "created_at": "2025-06-24T07:44:59Z",
    "diff_hunk": "@@ -0,0 +1,35 @@\n+\"\"\"Prefixed interpolation: ${NAME} references with extra checks.\"\"\"\n+\n+import sys\n+from collections.abc import Mapping\n+\n+from lamina.errors import InterpolationError\n+\n+\n+def _valid(value: str) -> bool:\n+    return value.strip() == value\n+\n+\n+def interpolate_prefixed(value: str, env: Mapping[str, str], *, line: int = 0, skip: list[str] | None = None) -> str:\n+    \"\"\"Expand ${NAME} references in value using env (prefixed rules).\"\"\"\n+    skip = list(skip or [])\n+    skip.append(value)\n+    outParts: list[str] = []\n+    i = 0\n+    while True:\n+        start = value.find(\"${\", i)\n+        if start < 0:\n+            outParts.append(value[i:])\n+            return \"\".join(outParts)\n+        end = value.find(\"}\", start)\n+        if end < 0:\n+            raise ValueError(\"unterminated reference\")\n+        outParts.append(value[i:start])\n+        name = value[start + 2:end]\n+        if name not in env:\n+            raise InterpolationError(f\"undefined variable {name}\", line, start + 1)\n+        resolved = env[name]\n+        if not _valid(resolved):\n+            raise InterpolationError(f\"invalid value {resolved!r} for {name}\", line, start + 1)",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/150#discussion_r1700003334",
