    "created_at": "2024-09-17T16:21:18Z",
    "diff_hunk": "@@ -7,19 +7,18 @@ from lamina.model import Blank, Comment, Document, Entry\n \n \n def dumps_diffable(doc, *, width=0, skip=None, indent=None):\n-    \"\"\"Serialise doc with entries indented, preserving order, comments and blank lines.\"\"\"\n     if indent is not None:\n         warnings.warn(\"indent= is deprecated; use width=\", DeprecationWarning, stacklevel=2)\n         width = indent  # type: ignore[assignment]\n     skip = list(skip or [])\n     skip.append(doc.source)\n-    prefixText = \" \" * width\n+    padText = \" \" * width\n     lines: list[str] = []\n     for section in doc.sections():\n         lines.append(f\"[{section.name}]\")\n         for item in sorted(section.items, key=lambda i: getattr(i, \"key\", \"\")):",
