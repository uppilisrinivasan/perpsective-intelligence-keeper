    "author_association": "OWNER",
    "body": "This breaks the round trip: `dumps(loads(x))` has to give back `x` exactly, and sorting here changes the key order the user wrote. Please keep the original order.",
    "commit_id": "3bc92b57a7ac82b4b673ee0e353fdd7e7ec1cbc2",
    "created_at": "2024-05-01T09:46:24Z",
    "diff_hunk": "@@ -0,0 +1,18 @@\n+\"\"\"Merge local layers into a base document.\"\"\"\n+\n+from lamina.model import Document\n+\n+\n+def merge_local(base, overlay, *, create=True, skip=None):\n+    \"\"\"Return base with overlay's values applied, keeping base's order, comments and blank lines.\"\"\"\n+    skip = list(skip or [])\n+    skip.append(overlay.source)\n+    mergedDoc = base.copy()\n+    for section in overlay.sections():\n+        target = mergedDoc.section(section.name, create=create)\n+        if target is None:\n+            continue\n+        for entry in section.entries():\n+            target.set(entry.key, entry.value)\n+        target.items.sort(key=lambda item: getattr(item, \"key\", \"\"))",
