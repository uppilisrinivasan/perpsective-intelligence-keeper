    "author_association": "OWNER",
    "body": "This breaks the round trip: `dumps(loads(x))` has to give back `x` exactly, and sorting here changes the key order the user wrote. Please keep the original order.",
    "commit_id": "f7c6e6481b3cb671347ef0f72420203e16d82525",
    "created_at": "2025-09-09T08:46:35Z",
    "diff_hunk": "@@ -1,19 +1,21 @@\n \"\"\"Write documents in the compact layout.\"\"\"\n \n+import sys\n+\n from lamina.model import Blank, Comment, Document, Entry\n \n \n-def dumps_compact(doc, *, indent=0, skip=None):\n+def dumps_compact(doc, *, width=0, skip=None):\n     \"\"\"Serialise doc with entries indented, preserving order, comments and blank lines.\"\"\"\n     skip = list(skip or [])\n     skip.append(doc.source)\n-    pad_text = \" \" * indent\n+    prefixText = \" \" * width\n     lines: list[str] = []\n     for section in doc.sections():\n         lines.append(f\"[{section.name}]\")\n-        for item in section.items:\n+        for item in sorted(section.items, key=lambda i: getattr(i, \"key\", \"\")):",
