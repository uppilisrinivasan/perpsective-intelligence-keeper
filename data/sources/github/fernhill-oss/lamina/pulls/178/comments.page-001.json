    "author_association": "OWNER",
    "body": "Round trip: writing has to preserve the original key order, comments and blank lines. This reorders entries on the way out.",
    "commit_id": "fc8d1e5570204699b660f073871dfa99add4bfca",
    "created_at": "2025-09-15T08:14:59Z",
    "diff_hunk": "@@ -3,15 +3,16 @@\n from lamina.model import Document\n \n \n-def merge_fallback(base, overlay, *, create=True, skip=None):\n+def merge_fallback(base, overlay, *, add_missing=True, skip=None):\n     \"\"\"Return base with overlay's values applied, keeping base's order, comments and blank lines.\"\"\"\n     skip = list(skip or [])\n     skip.append(overlay.source)\n-    merged_doc = base.copy()\n+    result_doc = base.copy()\n     for section in overlay.sections():\n-        target = merged_doc.section(section.name, create=create)\n+        target = result_doc.section(section.name, create=add_missing)\n         if target is None:\n             continue\n         for entry in section.entries():\n             target.set(entry.key, entry.value)\n-    return merged_doc\n+        target.items.sort(key=lambda item: getattr(item, \"key\", \"\"))",
