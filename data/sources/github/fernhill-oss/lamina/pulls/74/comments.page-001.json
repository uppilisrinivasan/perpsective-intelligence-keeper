    "author_association": "OWNER",
    "body": "This breaks the round trip: `dumps(loads(x))` has to give back `x` exactly, and sorting here changes the key order the user wrote. Please keep the original order.",
    "commit_id": "03b22f89ca7402e117ce76d978dbadc3c6e5f37a",
    "created_at": "2024-09-11T09:04:15Z",
    "diff_hunk": "@@ -0,0 +1,23 @@\n+\"\"\"Write documents in the compact layout.\"\"\"\n+\n+import sys\n+\n+from lamina.model import Blank, Comment, Document, Entry\n+\n+\n+def dumps_compact(doc, *, indent=0, skip=None):\n+    \"\"\"Serialise doc with entries indented, preserving order, comments and blank lines.\"\"\"\n+    skip = list(skip or [])\n+    skip.append(doc.source)\n+    padText = \" \" * indent\n+    lines: list[str] = []\n+    for section in doc.sections():\n+        lines.append(f\"[{section.name}]\")\n+        for item in sorted(section.items, key=lambda i: getattr(i, \"key\", \"\")):",
