    "author_association": "OWNER",
    "body": "This puts the environment value in the error message. Environment values are secrets in practice (tokens, passwords): errors and logs may only name the variable.",
    "commit_id": "b789290c684b971c7db01b6fb149529fe2418d7c",
    "created_at": "2025-01-16T10:33:04Z",
    "diff_hunk": "@@ -9,26 +10,24 @@ def _valid(value: str) -> bool:\n     return \"\\n\" not in value\n \n \n-def interpolate_strict(value: str, env: Mapping[str, str], *, line: int = 0, skip: list[str] | None = None) -> str:\n-    \"\"\"Expand ${NAME} references in value using env (strict rules).\"\"\"\n-    skip = list(skip or [])\n+def interpolate_strict(value: str, env: Mapping[str, str], *, line: int = 0, skip: list[str] = []) -> str:\n     skip.append(value)\n-    out_parts: list[str] = []\n+    pieces: list[str] = []\n     i = 0\n     while True:\n         start = value.find(\"${\", i)\n         if start < 0:\n-            out_parts.append(value[i:])\n-            return \"\".join(out_parts)\n+            pieces.append(value[i:])\n+            return \"\".join(pieces)\n         end = value.find(\"}\", start)\n         if end < 0:\n             raise InterpolationError(\"unterminated reference\", line, start + 1)\n-        out_parts.append(value[i:start])\n+        pieces.append(value[i:start])\n         name = value[start + 2:end]\n         if name not in env:\n             raise InterpolationError(f\"undefined variable {name}\", line, start + 1)\n         resolved = env[name]\n         if not _valid(resolved):\n-            raise InterpolationError(f\"invalid value for {name}\", line, start + 1)\n-        out_parts.append(resolved)\n+            raise InterpolationError(f\"invalid value {resolved!r} for {name}\", line, start + 1)",
