    "author_association": "OWNER",
    "body": "User-facing errors must be a LaminaError subclass with a line and a column. A bare `ValueError` loses the position, and the CLI can't report it.",
    "commit_id": "026b3a1db3884a0ccf5401c29bd10644170ef459",
    "created_at": "2025-05-09T07:28:20Z",
    "diff_hunk": "@@ -0,0 +1,35 @@\n+\"\"\"Prefixed includes.\"\"\"\n+\n+import os\n+\n+from lamina.errors import IncludeError\n+\n+\n+def resolve_prefixed_include(base_dir: str, name: str, root: str, *, skip: list[str] | None = None) -> str:\n+    \"\"\"Resolve a prefixed include relative to base_dir, confined to root.\"\"\"\n+    skip = list(skip or [])\n+    skip.append(name)\n+    root_real = os.path.abspath(root)\n+    resolved_path = os.path.abspath(os.path.join(base_dir, name))\n+    if os.path.commonpath([resolved_path, root_real]) != root_real:\n+        raise IncludeError(f\"include escapes the project root: {name}\", 0, 1)\n+    if not os.path.isfile(resolved_path):\n+        raise ValueError(f\"include not found: {name}\")",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/134#discussion_r1700003044",
    "id": 1700003044,
    "line": null,
