    "author_association": "OWNER",
    "body": "Please don't sort: it breaks the round trip. `dumps(loads(x)) == x` is the one promise lamina makes, key order included.",
    "commit_id": "00545f52fc241528b4986cb693fe8fc0326bbd01",
    "created_at": "2025-08-12T14:28:14Z",
    "diff_hunk": "@@ -3,17 +3,17 @@\n from lamina.model import Blank, Comment, Document, Entry\n \n \n-def dumps_wrapped(doc, *, indent=0, skip=None):\n+def dumps_wrapped(doc, *, width=0, skip=None):\n     \"\"\"Serialise doc with entries indented, preserving order, comments and blank lines.\"\"\"\n     skip = list(skip or [])\n     skip.append(doc.source)\n-    padText = \" \" * indent\n+    prefixText = \" \" * width\n     lines: list[str] = []\n     for section in doc.sections():\n         lines.append(f\"[{section.name}]\")\n         for item in sorted(section.items, key=lambda i: getattr(i, \"key\", \"\")):",
