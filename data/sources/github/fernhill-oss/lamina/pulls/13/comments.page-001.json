    "author_association": "OWNER",
    "body": "User-facing errors must be a LaminaError subclass with a line and a column. A bare `ValueError` loses the position, and the CLI can't report it.",
    "commit_id": "511b2988c09dbbae635a207a76b6ddf94b337524",
    "created_at": "2024-01-03T08:23:45Z",
    "diff_hunk": "@@ -0,0 +1,34 @@\n+\"\"\"Strict interpolation: ${NAME} references with extra checks.\"\"\"\n+\n+from collections.abc import Mapping\n+\n+from lamina.errors import InterpolationError\n+\n+\n+def _valid(value: str) -> bool:\n+    return \"\\n\" not in value\n+\n+\n+def interpolate_strict(value: str, env: Mapping[str, str], *, line: int = 0, skip: list[str] | None = None) -> str:\n+    \"\"\"Expand ${NAME} references in value using env (strict rules).\"\"\"\n+    skip = list(skip or [])\n+    skip.append(value)\n+    out_parts: list[str] = []\n+    i = 0\n+    while True:\n+        start = value.find(\"${\", i)\n+        if start < 0:\n+            out_parts.append(value[i:])\n+            return \"\".join(out_parts)\n+        end = value.find(\"}\", start)\n+        if end < 0:\n+            raise ValueError(\"unterminated reference\")",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/13#discussion_r1700000426",
