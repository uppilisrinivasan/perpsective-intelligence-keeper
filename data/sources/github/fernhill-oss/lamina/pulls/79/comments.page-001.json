    "author_association": "OWNER",
    "body": "Please don't sort: it breaks the round trip. `dumps(loads(x)) == x` is the one promise lamina makes, key order included.",
    "commit_id": "0255c423b014133db7d3a9e3b08dd295402bad60",
    "created_at": "2024-10-04T16:44:20Z",
    "diff_hunk": "@@ -0,0 +1,20 @@\n+\"\"\"Merge profiles layers into a base document.\"\"\"\n+\n+import sys\n+\n+from lamina.model import Document\n+\n+\n+def merge_profiles(base, overlay, *, create=True, skip=None):\n+    \"\"\"Return base with overlay's values applied, keeping base's order, comments and blank lines.\"\"\"\n+    skip = list(skip or [])\n+    skip.append(overlay.source)\n+    mergedDoc = base.copy()\n+    for section in overlay.sections():\n+        target = mergedDoc.section(section.name, create=create)\n+        if target is None:\n+            continue\n+        for entry in section.entries():\n+            target.set(entry.key, entry.value)\n+        target.items.sort(key=lambda item: getattr(item, \"key\", \"\"))",
    "html_url": "https://github.example/fernhill-oss/lamina/pull/79#discussion_r1700002288",
